# Copy this file to .env and fill in your own keys. NEVER commit .env (it is gitignored).
# Free-tier keys only. No paid or card-required step without the owner's explicit approval.
GEMINI_API_KEY=
GROQ_API_KEY=
# Langfuse Cloud free tier (used from Phase 5). EU region host shown; use the US host if your project is US.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
# record | replay | live  (replay is the default; CI only ever replays)
LLM_MODE=replay
